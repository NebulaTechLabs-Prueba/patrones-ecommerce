# Slug del repo en GitHub Pages para el basePath del export estatico.
# En local se deja vacio (raiz). El workflow de deploy lo inyecta para produccion.
# NEXT_PUBLIC_BASE_PATH=/patrones-ecommerce

# --- Correo transaccional (Resend) · Fase 2 ---
# Sin RESEND_API_KEY la app NO envia correos (la demo funciona igual).
# Provisionar en Vercel: Project > Settings > Environment Variables (Production).
#
# API key de Resend (https://resend.com > API Keys).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Remitente. El dominio debe estar VERIFICADO en Resend (registros DKIM/SPF en el
# DNS de patronesdevzla.com). Formato: "Nombre <buzon@dominio>".
# RESEND_FROM=PATRONES <no-reply@patronesdevzla.com>
#
# Casilla interna opcional: recibe copia oculta (BCC) de cada confirmacion de pedido.
# RESEND_SHOP_INBOX=pedidos@patronesdevzla.com
